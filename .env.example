# =============================================================================
# Leonis AI - backend configuration
# Copy to .env (git-ignored). scripts/windows/20-setup-project.ps1 does this for you
# and fills every secret with a random value. Never commit .env.
# =============================================================================

# ---- application ----
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=console                  # console | json
ENABLE_DEV_ENDPOINTS=true           # /api/v1/dev/* (file preview); refused in production
# EXPOSE_DIAGNOSTICS=               # default: true except in production

# ---- HTTP ----
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- database: three roles (D07 section 5) ----
# app_api: the FastAPI process. app_worker: the background worker. app_owner: migrations.
DATABASE_URL=postgresql://app_api:CHANGE_ME@127.0.0.1:5432/copilot_dev
DATABASE_WORKER_URL=postgresql://app_worker:CHANGE_ME@127.0.0.1:5432/copilot_dev
DATABASE_MIGRATION_URL=postgresql://app_owner:CHANGE_ME@127.0.0.1:5432/copilot_dev
# Separate database for automated tests (never the dev database).
TEST_DATABASE_URL=postgresql://app_owner:CHANGE_ME@127.0.0.1:5432/copilot_test

# ---- local model runtime (Ollama) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=4096
EMBEDDING_DIMENSION=1024            # design assumption (D07); measured value is recorded at setup

# ---- secrets used by later modules (SEC-18) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME
APP_ENCRYPTION_KEY=CHANGE_ME
CUSTOMER_KEY_SECRET=CHANGE_ME
