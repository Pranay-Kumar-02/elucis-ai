# Frontend settings. Copy to frontend/.env.local (git-ignored) only if you need to change them.
# Only VITE_* variables reach the browser bundle: never put secrets here.

# Where the dev server proxies /api (FastAPI). Default: http://127.0.0.1:8000
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# API base URL used by the browser. Empty = same origin (/api via the dev proxy or the
# production reverse proxy). Set only when the API is served from another origin.
VITE_API_BASE_URL=
